# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# --- AI -------------------------------------------------------------------
# Without a key the app still works: questions are answered directly by the
# deterministic analytics engine, clearly labelled as non-AI answers.
ANTHROPIC_API_KEY=

# --- Data -----------------------------------------------------------------
# true  = always use the bundled demo snapshot (no network calls at all)
# false = try the live BTS source first, then cache, then demo
USE_DEMO_DATA=false

# --- Services -------------------------------------------------------------
# The Streamlit frontend uses this to reach the FastAPI backend.
# On Render this is set automatically from the backend service's host.
API_BASE_URL=http://localhost:8000

# --- Live operational context ---------------------------------------------
# AviationWeather.gov (NOAA/NWS) needs no API key. This is current-conditions
# context only; it never feeds the Expansion Score or any ranking.
# ENABLE_LIVE_WEATHER=true
# AVIATION_WEATHER_BASE_URL=https://aviationweather.gov/api/data
# AVIATION_WEATHER_TIMEOUT_SECONDS=8
# AVIATION_WEATHER_CACHE_TTL_SECONDS=600

# --- Analytics ------------------------------------------------------------
# Long-haul is defined as a non-stop segment of at least this many statute miles.
LONG_HAUL_MILES=2500

# --- Optional -------------------------------------------------------------
# ANTHROPIC_MODEL=claude-opus-5
# LOG_LEVEL=INFO
# CACHE_TTL_SECONDS=21600
# DATA_TIMEOUT_SECONDS=10
# CORS_ALLOW_ORIGINS=*
#
# Live BTS T-100 Segment data. Point BTS_LOCAL_EXTRACT_DIR at a folder of
# downloaded TranStats CSV/ZIP extracts, or BTS_T100_URL at a direct download.
# Leave both empty to run on the bundled demo snapshot.
# BTS_LOCAL_EXTRACT_DIR=
# BTS_T100_URL=
